# 行囊 Knapsack · Android 签名配置模板
#
# 用法：
#   1) 生成 keystore（只在首次，或密钥丢失时）：
#        keytool -genkeypair -v -keystore knapsack-release.keystore `
#          -alias knapsack -keyalg RSA -keysize 4096 -validity 10000 `
#          -storetype PKCS12
#      注意：这个文件与下面的密码【绝不能】提交到 git。
#   2) 复制本文件为 keystore.properties，填真实值。
#   3) 构建 release：
#        cd android && .\gradlew.bat assembleRelease
#
# 丢失 keystore = 永久无法给同一应用更新，请妥善备份。

KNAPSACK_KEYSTORE=knapsack-release.keystore
KNAPSACK_STORE_PASSWORD=CHANGE_ME
KNAPSACK_KEY_ALIAS=knapsack
KNAPSACK_KEY_PASSWORD=CHANGE_ME